NODE_ENV=development
PORT=5000

# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ApniCars?schema=public

JWT_SECRET=
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Public API response cache - optional, defaults to localhost if unset
REDIS_URL=redis://localhost:6379

# Email OTP auth
GMAIL_USER=example8@gmail.com
GMAIL_APP_PASSWORD=

# Initial super admin used by `npm run prisma:seed`
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_MOBILE=
SEED_ADMIN_PASSWORD=
